// Matches outside fenced code blocks. Edit the prefixes (default: qsl, tl) to the internal crate prefixes of your repository.
text := import("text")
patterns := ["`(qsl|tl)-[a-z0-9-]+`", "\\b(qsl|tl)-[a-z0-9-]+\\b"]
fences := []
f := text.re_find("(?ms)^[ \\t]*(?:```|~~~).*?^[ \\t]*(?:```|~~~)[ \\t]*$", scope, -1)
if f != undefined {
  for i := 0; i < len(f); i++ {
    fences = append(fences, f[i][0])
  }
}
matches := []
for p in patterns {
  m := text.re_find(p, scope, -1)
  if m != undefined {
    for i := 0; i < len(m); i++ {
      c := m[i][0]
      inside := false
      for j := 0; j < len(fences); j++ {
        if c.begin >= fences[j].begin && c.begin < fences[j].end {
          inside = true
        }
      }
      if !inside {
        matches = append(matches, {begin: c.begin, end: c.end})
      }
    }
  }
}
