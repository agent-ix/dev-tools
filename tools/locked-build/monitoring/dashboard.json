{
  "id": null,
  "uid": "locked-build-hosts",
  "title": "Locked-build host telemetry",
  "description": "Build admission, execution and failures by host and class. Memory watchdog peaks are sampled lower bounds. Identity totals have lifetime cardinality limits.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "locked-build",
    "builds"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "annotations": {
    "list": [

    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(ix_build_info, host)",
          "refId": "host"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "class",
        "label": "Class",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(ix_build_queue_depth, class)",
          "refId": "class"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed builds by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, outcome) (rate(ix_build_requests_total{host=~\"$host\",class=~\"$class\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{__name__}} {{class}} {{outcome}} {{code}} {{cause}} {{reason}} {{measurement}} {{lane}} {{ticket}} {{repo}} {{subcommand}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Failures by code and cause",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, code, cause, exit_class, signal) (ix_build_failures_total{host=~\"$host\",class=~\"$class\"})",
          "legendFormat": "{{host}} {{__name__}} {{class}} {{outcome}} {{code}} {{cause}} {{reason}} {{measurement}} {{lane}} {{ticket}} {{repo}} {{subcommand}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue wait p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (host, le) (rate(ix_build_wait_seconds_bucket{host=~\"$host\",class=~\"$class\"}[$__rate_interval])))",
          "legendFormat": "{{host}} p50",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (host, le) (rate(ix_build_wait_seconds_bucket{host=~\"$host\",class=~\"$class\"}[$__rate_interval])))",
          "legendFormat": "{{host}} p95",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (host, le) (rate(ix_build_wait_seconds_bucket{host=~\"$host\",class=~\"$class\"}[$__rate_interval])))",
          "legendFormat": "{{host}} p99",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
