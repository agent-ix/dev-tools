        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build_identity_total{host=~\"$host\",class=~\"$class\"}",
          "legendFormat": "{{host}} {{__name__}} {{class}} {{outcome}} {{code}} {{cause}} {{reason}} {{measurement}} {{lane}} {{ticket}} {{repo}} {{subcommand}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    }
  ]
}
