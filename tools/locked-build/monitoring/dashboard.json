{
  "uid": "locked-build",
  "title": "Locked-build queue health",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ix_build_info, host)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Wait p50 / p95 / p99 by class",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Wait p50 / p95 / p99 by class",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:wait_p50_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{class}} {{lane}} {{repo}} {{subcommand}} {{code}}"
        },
        {
          "refId": "B",
          "expr": "ix_build:wait_p95_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{class}} {{lane}} {{repo}} {{subcommand}} {{code}}"
        },
        {
          "refId": "C",
          "expr": "ix_build:wait_p99_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{class}} {{lane}} {{repo}} {{subcommand}} {{code}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Priority and starvation",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "title": "Priority and starvation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
