      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:oldest_queued_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{class}} {{lane}} {{repo}} {{subcommand}} {{code}}"
        }
      ]
    },
    {
      "id": 5,
