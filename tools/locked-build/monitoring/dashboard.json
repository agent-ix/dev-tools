{
  "uid": "locked-build",
  "title": "Build storage and cache",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ix_build_info, host)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "cache_role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(ix_build_cache_policy_info, cache_role)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "mountpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay\"}, mountpoint)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(node_disk_io_time_seconds_total{host=~\"$host\"}, device)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Kache",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Kache up",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache_up{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{store}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Hit / miss ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache:hit_ratio{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} hit"
        },
        {
          "refId": "B",
          "expr": "ix_kache:miss_ratio{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} miss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Hits / misses per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache:hits_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} hits"
        },
        {
          "refId": "B",
          "expr": "ix_kache:misses_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} misses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Compile time saved per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache:time_saved_seconds_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Local store size / cap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache_store_bytes{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} used"
        },
        {
          "refId": "B",
          "expr": "ix_kache_store_limit_bytes{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} cap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Store entries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache_entries{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Evicted bytes per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache:evicted_bytes_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Local / remote hits per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache:local_hits_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} local"
        },
        {
          "refId": "B",
          "expr": "ix_kache:remote_hits_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} remote"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Remote reachable (−1 unknown)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_kache_remote_reachable{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Builds",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Build run time p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:run_p50_seconds{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} p50"
        },
        {
          "refId": "B",
          "expr": "ix_build:run_p95_seconds{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Mean build run time by repo / subcommand",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:repo_run_mean_seconds{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{repo}} {{subcommand}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Builds per hour by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:builds_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Queue wait p95 by class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 74,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:wait_p95_seconds{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Failures per hour by code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:failures_1h{host=~\"$host\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Storage",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 86,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "title": "Build filesystem free space — select mountpoint",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 87,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:storage_free_bytes{host=~\"$host\",mountpoint=~\"$mountpoint\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "Build device IO utilisation — select device",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 93,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ix_build:storage_io_utilisation_pct{host=~\"$host\",device=~\"$device\"} and on(host) ix_build_cache_policy_info{cache_role=~\"$cache_role\"}",
          "legendFormat": "{{host}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    }
  ]
}
